NEXT_PUBLIC_SANITY_PROJECT_ID=iq8peaua
NEXT_PUBLIC_SANITY_DATASET=production
# URL publik tanpa slash di akhir. Gunakan domain staging saat build staging.
SITE_URL=https://www.lbalogistics.id
# Set false pada staging agar crawler memblokir seluruh situs.
ROBOTS_INDEX=true
# Translasi upstream default nonaktif. Aktifkan hanya setelah WAF/proxy diverifikasi.
TRANSLATE_API_ENABLED=false
# Opsional. Jangan commit nilai rahasia.
# GOOGLE_TRANSLATE_API_KEY=
